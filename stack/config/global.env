# Host-wide settings. Read by bash (scripts/lib.sh) and by systemd (EnvironmentFile=).
# Format rules (checked by lib.sh): KEY=value, KEY="value" or KEY='value'; no $, backticks or backslashes.

# Everything the stack owns lives under LLM_ROOT (hf-cache, venv, engines, models, logs, ...).
# Bootstrap creates it owned by LLM_USER, which must be able to traverse every parent directory.
LLM_ROOT=/home/sigura/llm_coder/llm
LLM_USER=sigura
HF_HUB_DISABLE_TELEMETRY=1

# Hardware expectations checked by 00-check-host.sh
EXPECTED_GPUS=4
MIN_DRIVER_VERSION=570
MIN_CUDA_VERSION=12.8
CUDA_HOME=/usr/local/cuda
# Make CUDA device ids follow nvidia-smi (PCI bus) order so TENSOR_SPLIT lines up with nvidia-smi output.
CUDA_DEVICE_ORDER=PCI_BUS_ID
REQUIRED_TOOLS="git cmake jq curl numactl python3 sha256sum flock lscpu nvidia-smi ss df lsblk"

# Runtime defaults; a model .env may override any of them.
THREADS=auto
NUMA_MODE=distribute
BIND_HOST=0.0.0.0
# llm-serve.sh: free the model (VRAM and RAM) after this many idle seconds; the next request reloads it. -1 = never.
SLEEP_IDLE_SEC=600
# Address clients use in baseURL; empty = first address from "hostname -I".
SERVER_IP=

# Engine build
LLAMA_CPP_REPO=https://github.com/ggml-org/llama.cpp.git
CUDA_ARCHS="86;89"
BUILD_JOBS=auto
CMAKE_EXTRA_ARGS="-DLLAMA_OPENSSL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF"
SMOKE_MODEL_REPO=ggml-org/stories15M_MOE
SMOKE_MODEL_REVISION=b6dd737497465570b5f5e962dbc9d9454ed1e0eb
SMOKE_MODEL_FILE=stories15M_MOE-Q8_0.gguf
SMOKE_MODEL_SHA256=c7aa6863f9a4b3cdf19716e2c95622dcbd3bd06989324bf1ac8e60486ef8e881
SMOKE_PORT=18099

# Downloads
FREE_SPACE_MARGIN_PCT=10
DOWNLOAD_RETRIES=5
DOWNLOAD_BACKOFF_SEC=30
DOWNLOAD_WORKERS=8
DOWNLOAD_STREAMS=8
DOWNLOAD_STREAM_MIN_BYTES=2000000000
HASH_JOBS=8

# Tuning / benchmark (30-benchmark.sh)
BENCH_PORT=18080
BENCH_REPS=2
VRAM_MARGIN_MIB=1800
# Relative share per GPU, matched as a substring of the nvidia-smi name; unmatched GPUs get 1.0.
GPU_SHARE_FACTORS="3090=0.85"
# In a devbox container only distribute works: seccomp blocks set_mempolicy (numactl --interleave/--localalloc)
# without CAP_SYS_NICE. On bare metal: "distribute interleave node0-3".
TUNE_NUMA_MODES=distribute
TUNE_REBALANCE_ROUNDS=3
SERVER_READY_TIMEOUT=2400
REQUEST_TIMEOUT=3600

# Health check (50-healthcheck.sh)
HEALTH_LONG_CTX_TOKENS=100000

# OpenCode client (60-client-config.sh)
CLIENT_TIMEOUT_MS=3600000

# Identity for commits the scripts make in this repo
GIT_USER_NAME=llm-stack
GIT_USER_EMAIL=llm-stack@localhost
