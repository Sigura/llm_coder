# Qwen3-Coder-Next 80B-A3B, unsloth dynamic 4-bit GGUF, fully in VRAM on GPUs 2,3.
# Baseline for the RCO ~3.5 bpw experiment (qwen3-coder-next-bf16 holds the source).
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=qwen3-coder-next
HF_REPO=unsloth/Qwen3-Coder-Next-GGUF
HF_REVISION=ce09c67b53bc8739eef83fe67b2f5d293c270632
HF_INCLUDE="Qwen3-Coder-Next-UD-Q4_K_XL.gguf"
MAIN_GGUF=Qwen3-Coder-Next-UD-Q4_K_XL.gguf

ALIAS=qwen3-coder-next
PORT=8083
CTX=65536
# Long-context health check must fit CTX (global default 100000).
HEALTH_LONG_CTX_TOKENS=56000
N_CPU_MOE=0
TENSOR_SPLIT=1,1
NUMA_MODE=none
THREADS=8
EXTRA_ARGS="--jinja -fa on -ctk q8_0 -ctv q8_0 --parallel 1 -dev CUDA2,CUDA3"

CLIENT_KEY_ENV=LOCAL_CODER_NEXT_KEY
CLIENT_MODEL_NAME="Qwen3-Coder-Next 80B-A3B (local)"
OUTPUT_LIMIT=32768
REASONING=0
