# Qwen3.8-27B dense, UD-Q6_K: main coding model on GPU 2 (best on burnish's coding eval, thinking off).
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=qwen3.8-27b
HF_REPO=unsloth/Qwen3.8-27B-GGUF
HF_REVISION=4af51b3542f775b0a8e4b310bfb3f17e01c306c9
HF_INCLUDE="Qwen3.8-27B-UD-Q6_K.gguf"
MAIN_GGUF=Qwen3.8-27B-UD-Q6_K.gguf

ALIAS=qwen3.8-27b
PORT=8086
CTX=65536
# Long-context health check must fit CTX (global default 100000).
HEALTH_LONG_CTX_TOKENS=56000
# Every weight on GPU 2 (-dev CUDA2); GPUs 0,1 serve DeepSeek on 8080. Few CPU threads so DeepSeek keeps the CPU.
N_CPU_MOE=0
TENSOR_SPLIT=
NUMA_MODE=none
THREADS=8
# Thinking off and the model card's non-thinking sampling: the setup that scored best in the eval.
EXTRA_ARGS="--jinja --reasoning-format deepseek --reasoning-budget 0 -fa on -ctk q8_0 -ctv q8_0 --parallel 1 -dev CUDA2 --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0 --presence-penalty 1.5"

CLIENT_KEY_ENV=LOCAL_QWEN38_KEY
CLIENT_MODEL_NAME="Qwen3.8 27B (local)"
OUTPUT_LIMIT=32768
REASONING=0
