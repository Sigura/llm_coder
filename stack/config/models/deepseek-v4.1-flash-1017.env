# DeepSeek-V4.1-Flash-1017, unsloth dynamic 2-bit GGUF.
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=deepseek-v4.1-flash-1017
HF_REPO=unsloth/DeepSeek-V4.1-Flash-1017-GGUF
# Re-uploaded 2026-11-02 after the broken first upload (llama.cpp#31385); keep pinned.
HF_REVISION=2688c0c3c2c3b052ec4f6d10a8417b0ef7ee4eba
# Shard 7 of 7 is the Engram n-gram table (Q5_K, 135 GB), see engram/README.md in the repo.
HF_INCLUDE="UD-Q2_K_XL/*"
# DSpark speculative-decoding drafter (dspark/README.md); only loaded when # DSpark needs 7.6 GB on a GPU; on 2 GPUs that space holds more tg as expert layers (9-10 vs 11-12 tok/s).
SPEC_ENABLED=0.
EXTRA_FILES="dspark-DeepSeek-V4.1-Flash-1017-Q8_0.gguf"
MAIN_GGUF=UD-Q2_K_XL/DeepSeek-V4.1-Flash-1017-UD-Q2_K_XL-00001-of-00007.gguf
MIN_ENGINE_REF=b11870

ALIAS=deepseek-v4.1-flash
PORT=8080
CTX=131072
# Hand-tuned 2026-11-13 (LLM_ROOT/results/tg-study-2026-11-13): GPUs 0,1 only; routed experts of layers 18,19 on
# CUDA0 and 38,39 on CUDA1 (the last layers of each GPU's half), all others on CPU. Warm tg 11-12 tok/s on real
# text vs 8.2 for N_CPU_MOE=37 on 4 GPUs. N_CPU_MOE=0 because the -ot list in EXTRA_ARGS places every expert.
N_CPU_MOE=0
TENSOR_SPLIT=1,1
NUMA_MODE=distribute
# 48 threads beat 64-96 for tg here; --poll 0 (no busy-wait between ops) is faster too and avoids the full-load
# power step that preceded the host hangs.
THREADS=48
# --cache-ram 0: workaround for cached-prefix output corruption (llama.cpp#30944, open).
# per_layer_token_embd is the Engram table: keep it in host memory, read lazily.
EXTRA_ARGS="--jinja --reasoning-format deepseek -fa on --cache-ram 0 --parallel 1 -b 4096 -ub 2048 --poll 0 -dev CUDA0,CUDA1 -ot per_layer_token_embd.weight=CPU,blk[.](18|19)[.]ffn_(up|gate|down)_exps=CUDA0,blk[.](38|39)[.]ffn_(up|gate|down)_exps=CUDA1,ffn_(up|gate|down)_exps=CPU"

SPEC_DRAFT_GGUF=dspark-DeepSeek-V4.1-Flash-1017-Q8_0.gguf
SPEC_ARGS="--spec-type draft-dspark --spec-draft-n-max 3 -ngld 999 -devd CUDA2"
# DSpark needs 7.6 GB on a GPU; on 2 GPUs that space holds more tg as expert layers (9-10 vs 11-12 tok/s).
SPEC_ENABLED=0

CLIENT_KEY_ENV=LOCAL_DEEPSEEK_KEY
CLIENT_MODEL_NAME="DeepSeek V4.1 Flash 1017 (local)"
OUTPUT_LIMIT=32768
REASONING=1
