# DeepSeek-V4.1-Flash-1017, ISTA-DASLab GSQ-RCO IQ2_XXS (2.00 bpw backbone, 138 GB) + shared Engram IQ4_NL (111 GB).
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=deepseek-v4.1-flash-1017-gsq
HF_REPO=ISTA-DASLab/DeepSeek-V4.1-Flash-1017-GSQ-RCO-GGUF
# 2026-10-28: llama.cpp DeepSeek-V4.1 layout (b11870+), see the repo README "Update, October 27, 2026".
HF_REVISION=65d53bc8be65123e255ff02f3ded958b6dbf54fd
HF_INCLUDE="DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-0000?-of-00006.gguf"
EXTRA_FILES="DeepSeek-V4.1-Flash-Engram-IQ4_NL.gguf"
# The shared Engram file is shard 6 of every build (repo README).
SPLIT_LINKS="DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00006-of-00006.gguf:DeepSeek-V4.1-Flash-Engram-IQ4_NL.gguf"
MAIN_GGUF=DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00001-of-00006.gguf
MIN_ENGINE_REF=b11870

ALIAS=deepseek-v4.1-flash-gsq
PORT=8081
CTX=131072
# Tuned by 30-benchmark.sh; 999 = every routed expert on CPU (always fits).
N_CPU_MOE=999
TENSOR_SPLIT=
NUMA_MODE=distribute
THREADS=auto
# --cache-ram 0: workaround for cached-prefix output corruption (llama.cpp#30944, open).
# per_layer_token_embd is the Engram table: keep it in host memory, read lazily.
EXTRA_ARGS="--jinja --reasoning-format deepseek -fa on --cache-ram 0 --parallel 1 -b 4096 -ub 4096 -ot per_layer_token_embd.weight=CPU"

# No DSpark drafter in this repo (it ships with the unsloth repo only).
SPEC_ENABLED=0

CLIENT_KEY_ENV=LOCAL_DEEPSEEK_GSQ_KEY
CLIENT_MODEL_NAME="DeepSeek V4.1 Flash 1017 GSQ-RCO IQ2_XXS (local)"
OUTPUT_LIMIT=32768
REASONING=1
