# DeepSeek-V4.1-Flash-1017, original FP8/MXFP4 checkpoint on SGLang + KTransformers (llm/engines/alt/kt-wrapper).
# Same format rules as global.env. Keys set here override global.env; KT_* and SGLANG_* pass through to serve.sh.
# Replaces deepseek-v4.1-flash-1017 (llama.cpp): same port, alias and API key, and both need most of the host RAM.
# LLM_ROOT/results/kt-review-2026-11-21: one 4090 + 64 threads pp 259/560 tok/s (8k/44.5k prompts) vs llama.cpp
# 100/126, tg 13.8 vs 14.1-14.5; evalpair seed 1 pass@2 20 vs 21; tool calls 4/4.

MODEL_ID=deepseek-v4.1-flash-1017-fp8
ENGINE=kt
HF_REPO=deepseek-ai/DeepSeek-V4.1-Flash-1017
HF_REVISION=08c8657f02291e11b6f6b63e0e16014f8e748518
KEY_ID=deepseek-v4.1-flash-1017

ALIAS=deepseek-v4.1-flash
PORT=8080
CTX=131072
# The container has no /usr/local/cuda: engram-adapter loads libcudart from the conda env.
CUDA_HOME=/home/sigura/.devbox/conda/envs/llm_coder
# KT's attention needs SM89: 4090s only. GPU 0 keeps GPUs 2,3 for the Qwens.
KT_GPUS=0
KT_CPU_THREADS=64
# Two running requests (two OpenCode sessions) ran out of VRAM on one 4090 with 36,864-token prefill chunks; capped at
# 16384 (results/kt-review-2026-11-21, kt-two-1gpu-c16k): a lone request keeps tg 13.5 (pp 268/442, the 44.5k prompt
# -21%), two at once decode ~14.7 tok/s together. SGLANG_CHUNKED_PREFILL_SIZE is overridden by the wrapper's plan.
SGLANG_MAX_RUNNING_REQUESTS=2
KT_PREFILL_PLAN_CAP=16384
DSV41_LEND_MAX_CHUNK=16384

CLIENT_KEY_ENV=LOCAL_DEEPSEEK_KEY
CLIENT_MODEL_NAME="DeepSeek V4.1 Flash 1017 FP8 (local)"
OUTPUT_LIMIT=32768
REASONING=1
