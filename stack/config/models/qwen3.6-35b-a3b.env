# Qwen3.6-35B-A3B, unsloth dynamic 4-bit GGUF: the fast coding model, fully in VRAM on GPU 2.
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=qwen3.6-35b-a3b
HF_REPO=unsloth/Qwen3.6-35B-A3B-GGUF
HF_REVISION=a483e9e6cbd595906af30beda3187c2663a1118c
HF_INCLUDE="Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf"
MAIN_GGUF=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf

ALIAS=qwen3.6-35b-a3b
PORT=8082
CTX=65536
# Long-context health check must fit CTX (global default 100000).
HEALTH_LONG_CTX_TOKENS=56000
# Every weight on GPU 2 (-dev CUDA2); GPUs 0,1 serve DeepSeek on 8080. Few CPU threads so DeepSeek keeps the CPU.
N_CPU_MOE=0
TENSOR_SPLIT=
NUMA_MODE=none
THREADS=8
EXTRA_ARGS="--jinja --reasoning-format deepseek -fa on -ctk q8_0 -ctv q8_0 --parallel 1 -dev CUDA2"

CLIENT_KEY_ENV=LOCAL_QWEN36_KEY
CLIENT_MODEL_NAME="Qwen3.6 35B-A3B (local)"
OUTPUT_LIMIT=32768
REASONING=1
