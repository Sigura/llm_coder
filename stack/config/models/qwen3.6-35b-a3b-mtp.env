# Qwen3.6-35B-A3B with MTP heads (unsloth MTP GGUF): MTP speculative decoding test, GPU 2. Same GGUF quant as qwen3.6-35b-a3b.
# Same format rules as global.env. Keys set here override global.env.

MODEL_ID=qwen3.6-35b-a3b-mtp
HF_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
HF_REVISION=5bc3e238d916f48a861bac2f8a1990a0e9b7e98d
HF_INCLUDE="Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf"
MAIN_GGUF=Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf

ALIAS=qwen3.6-35b-a3b-mtp
PORT=8085
CTX=65536
# Long-context health check must fit CTX (global default 100000).
HEALTH_LONG_CTX_TOKENS=56000
# Every weight on GPU 2 (-dev CUDA2); GPUs 0,1 serve DeepSeek on 8080. Few CPU threads so DeepSeek keeps the CPU.
N_CPU_MOE=0
TENSOR_SPLIT=
NUMA_MODE=none
THREADS=8
EXTRA_ARGS="--jinja --reasoning-format deepseek -fa on -ctk q8_0 -ctv q8_0 --parallel 1 -dev CUDA2 --spec-type draft-mtp --spec-draft-n-max 2"

CLIENT_KEY_ENV=LOCAL_QWEN36_KEY
CLIENT_MODEL_NAME="Qwen3.6 35B-A3B MTP (local)"
OUTPUT_LIMIT=32768
REASONING=1
